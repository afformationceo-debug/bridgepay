# ============================================
# LINE Unify Pay - Environment Variables
# ============================================
# 이 파일을 .env.local로 복사하여 사용하세요
# cp .env.example .env.local

# ============================================
# App Configuration
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Unify Pay"
NODE_ENV=development

# ============================================
# Supabase Configuration
# ============================================
# Supabase 대시보드 > Project Settings > API에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (서버 사이드 전용 - 절대 프론트엔드에서 사용 금지!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# Upstash Redis Configuration
# ============================================
# Upstash 대시보드 > Database > REST API에서 확인
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxx

# ============================================
# Authentication
# ============================================
# JWT 서명용 시크릿 (최소 32자 이상)
# 생성: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# 암호화 키 (64자 hex string = 32 bytes)
# 생성: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================
# Kaia Blockchain Configuration
# ============================================
# 메인넷
KAIA_RPC_URL=https://public-en.node.kaia.io

# 테스트넷 (Kairos)
# KAIA_RPC_URL=https://public-en-kairos.node.kaia.io

# Chain ID
KAIA_CHAIN_ID=8217  # 메인넷
# KAIA_CHAIN_ID=1001  # Kairos 테스트넷

# Webhook Secret (카이아재단에서 제공)
KAIA_WEBHOOK_SECRET=your-webhook-secret-from-kaia

# ============================================
# LINE Unify Configuration (TBD)
# ============================================
# LINE Unify SDK 연동 시 필요한 정보
# UNIFY_API_URL=
# UNIFY_API_KEY=
# UNIFY_MERCHANT_ID=

# ============================================
# Stablecoin Contract Addresses
# ============================================
# USDT on Kaia
USDT_CONTRACT_ADDRESS=0x...

# JPYT (일본 엔화 스테이블코인)
JPYT_CONTRACT_ADDRESS=0x...

# TWDT (대만 달러 스테이블코인)
TWDT_CONTRACT_ADDRESS=0x...

# ============================================
# Payment Configuration
# ============================================
# 결제 만료 시간 (초)
PAYMENT_EXPIRY_SECONDS=600

# 최소 결제 금액 (원)
MIN_PAYMENT_KRW=1000

# 최대 결제 금액 (원)
MAX_PAYMENT_KRW=100000000

# ============================================
# Rate Limiting
# ============================================
# API 요청 제한 (분당)
RATE_LIMIT_PER_MINUTE=60

# 로그인 시도 제한 (분당)
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ============================================
# Monitoring & Logging (Optional)
# ============================================
# Sentry DSN
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================
# Email Configuration (Optional)
# ============================================
# Resend API Key (이메일 발송용)
# RESEND_API_KEY=re_xxxx

# 발신 이메일 주소
# EMAIL_FROM=noreply@unifypay.kr

# ============================================
# Feature Flags
# ============================================
# 개발 모드 기능
ENABLE_DEV_TOOLS=true

# 테스트 결제 모드
ENABLE_TEST_PAYMENTS=true

# ============================================
# Analytics (Optional)
# ============================================
# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
